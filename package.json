{
  "name": "qol-portal",
  "private": true,
  "description": "生活の質向上ポータル。kaitokune・kakeibou などのアプリへの入口",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohiaeni/qol-portal.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "npm run build && astro preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "astro check",
    "check": "biome check . && npm run prettier:check",
    "knip": "knip",
    "format": "biome check --write . && npm run prettier:write",
    "prettier:check": "prettier --check \"**/*.{md,yml,yaml}\"",
    "prettier:write": "prettier --write \"**/*.{md,yml,yaml}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "lefthook install",
    "cf-typegen": "wrangler types --strict-vars=false --env-file /dev/null",
    "spell": "cspell --no-progress ."
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "@vitest/coverage-istanbul": "^5.0.3",
    "cspell": "^10.3.6",
    "knip": "^6.40.0",
    "lefthook": "^2.2.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.148.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20261006.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "fsevents": false,
    "lefthook": false
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "astro": "^7.3.5"
  },
  "homepage": "https://github.com/ohiaeni/qol-portal#readme"
}
