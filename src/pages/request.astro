---
import { env } from "cloudflare:workers";
import { listApps } from "../lib/apps";
import type { Bindings } from "../lib/env";
import { BODY_MAX, createIssue, KINDS, parseRequest, TITLE_MAX } from "../lib/requests";

// シークレット（GITHUB_TOKEN）は Env の型に入らないので、Bindings として読む
const bindings: Bindings = env;
const apps = listApps(bindings).filter((app) => app.repo);
let error: string | null = null;
let values = { app: "", kind: "feature", title: "", body: "" };

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const parsed = parseRequest(form, apps);
  values = {
    app: String(form.get("app") ?? ""),
    kind: String(form.get("kind") ?? "feature"),
    title: String(form.get("title") ?? ""),
    body: String(form.get("body") ?? ""),
  };
  if (parsed.ok) {
    const repo = apps.find((app) => app.id === parsed.value.appId)?.repo;
    try {
      if (!repo) {
        throw new Error("repo is not set");
      }
      await createIssue(bindings, fetch, repo, parsed.value);
      return Astro.redirect("/request?sent=1", 303);
    } catch (e) {
      console.error(`failed to create an issue: ${e instanceof Error ? e.message : e}`);
      error = "送信できませんでした。時間をおいてもう一度試してください";
      Astro.response.status = 502;
    }
  } else {
    error = parsed.error;
    Astro.response.status = 400;
  }
}

const sent = Astro.url.searchParams.get("sent") === "1";
---

<html lang="ja">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0c0a09" media="(prefers-color-scheme: dark)">
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏡</text></svg>"
    >
    <title>要望を送る | 生活の質向上ポータル</title>
  </head>
  <body>
    <main>
      <p><a href="/">← ポータルに戻る</a></p>
      <h1>要望を送る</h1>
      <p class="lead">使っていて困ったことや、こうなってほしいことを教えてください。</p>
      {sent && <p class="notice" role="status">送信しました。ありがとうございます。</p>}
      {error && <p class="notice error" role="alert">{error}</p>}
      <form method="post">
        <label>
          対象のアプリ
          <select name="app" required>
            <option value="" disabled selected={!values.app}>選んでください</option>
            {apps.map((app) => <option value={app.id} selected={values.app === app.id}>{app.name}</option>)}
          </select>
        </label>
        <label>
          種類
          <select name="kind" required>
            {
              Object.entries(KINDS).map(([kind, { label }]) => (
                <option value={kind} selected={values.kind === kind}>{label}</option>
              ))
            }
          </select>
        </label>
        <label>
          タイトル
          <input name="title" required maxlength={TITLE_MAX} value={values.title}>
        </label>
        <label>
          内容
          <textarea name="body" required maxlength={BODY_MAX} rows="8">{values.body}</textarea>
        </label>
        <button type="submit">送信する</button>
      </form>
    </main>
  </body>
</html>

<style>
  main {
    max-width: 36rem;
    margin: 0 auto;
    padding: 2.5rem 1rem;
  }

  h1 {
    margin: 0;
    font-size: 1.5rem;
  }

  a {
    color: var(--accent);
  }

  .lead {
    margin: 0.25rem 0 1.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .notice {
    margin: 0 0 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--accent);
    border-radius: 0.5rem;
  }

  .error {
    border-color: var(--warning);
    color: var(--warning);
  }

  form {
    display: grid;
    gap: 1rem;
  }

  label {
    display: grid;
    gap: 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  select,
  input,
  textarea {
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--card);
    color: inherit;
    font: inherit;
    font-weight: 400;
  }

  button {
    padding: 0.75rem;
    border: none;
    border-radius: 0.5rem;
    background: var(--accent);
    color: #1c1917;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
</style>
